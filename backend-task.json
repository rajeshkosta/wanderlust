{
  "family": "wanderlust-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::339712745938:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "339712745938.dkr.ecr.ap-south-1.amazonaws.com/wanderlust-backend:latest",
      "portMappings": [
        { "containerPort": 5000 }
      ],
      "essential": true
    }
  ]
}
