{
  "family": "wanderlust-mongo",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "mongo",
      "image": "mongo:latest",
      "portMappings": [{ "containerPort": 27017 }],
      "essential": true
    }
  ]
}
