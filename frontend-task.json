{
  "family": "wanderlust-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::339712745938:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "339712745938.dkr.ecr.ap-south-1.amazonaws.com/wanderlust-frontend:latest",
      "portMappings": [
        { "containerPort": 5173 }
      ],
      "essential": true,
      "command": ["npm", "run", "dev", "--", "--host"]
    }
  ]
}
